    {
      "name": "Maintenance",
      "item": [
        {
          "name": "Create maintenance request",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": \"{{roomId}}\",\n  \"category\": \"Plumbing\",\n  \"description\": \"Leaking sink in the bathroom.\",\n  \"priority\": \"MEDIUM\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/maintenance-requests",
              "host": ["{{baseUrl}}"],
              "path": ["maintenance-requests"]
            },
            "description": "Create a maintenance request for a room the tenant is renting (TENANT, requires active tenancy). Priority: LOW | MEDIUM | HIGH | URGENT. Sets `{{maintenanceRequestId}}` from the response."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "execute": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.id) {",
                  "  pm.collectionVariables.set('maintenanceRequestId', json.data.id);",
