{
  "info": {
    "_postman_id": "6f1d2e8a-3c4b-4a5e-9c0d-2f3a4b5c6d7e",
    "name": "housing-backend",
    "description": "Housing & Roommate Management Platform API.\n\nStandard response envelope:\n- Success: `{ \"success\": true, \"message\": string, \"data\": any }`\n- Error:   `{ \"success\": false, \"message\": string, \"errors\": any }`\n\nAuthentication: most endpoints require a Bearer token. Login (Auth > Login) automatically stores the access token in the collection variable `token`, which is injected into every request via the collection-level Bearer auth.\n\nRun the login request first (demo admin: `admin@housing.com` / `Password123!`), then fill the id variables (`userId`, `propertyId`, `roomId`, `tenancyId`, ...) from response data as needed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "propertyId", "value": "", "type": "string" },
    { "key": "roomId", "value": "", "type": "string" },
    { "key": "tenancyId", "value": "", "type": "string" },
    { "key": "applicationId", "value": "", "type": "string" },
    { "key": "viewingRequestId", "value": "", "type": "string" },
    { "key": "rentPaymentId", "value": "", "type": "string" },
    { "key": "billSplitId", "value": "", "type": "string" },
    { "key": "maintenanceRequestId", "value": "", "type": "string" },
    { "key": "paymentId", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Liveness probe. Returns `{ success, message, data: { uptime, timestamp } }`."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@example.com\",\n  \"password\": \"Password123!\",\n  \"name\": \"New Tenant\",\n  \"phone\": \"+1-555-0204\",\n  \"role\": \"TENANT\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Create an account. `role` is `TENANT` or `OWNER` (default TENANT). Returns the user plus access/refresh tokens."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "execute": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.accessToken) {",
                  "  pm.collectionVariables.set('token', json.data.accessToken);",
                  "  console.log('Updated token from login response');",
                  "}",
                  "if (json && json.data && json.data.user && json.data.user.id) {",
                  "  pm.collectionVariables.set('userId', json.data.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@housing.com\",\n  \"password\": \"Password123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Login and store the returned access token in the collection variable `token`. Demo accounts: `admin@housing.com`, `owner1@housing.com`, `tenant1@housing.com` (all password `Password123!`)."
          }
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"<refresh-token-or-use-httpOnly-cookie>\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh-token",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh-token"]
            },
            "description": "Rotate the refresh token (also accepted via the `refreshToken` httpOnly cookie scoped to `/api/v1/auth`). Old token is revoked."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"<refresh-token-or-use-httpOnly-cookie>\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            },
            "description": "Revoke the current refresh token."
          }
        },
        {
          "name": "Google login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"<google-id-token>\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/google",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "google"]
            },
            "description": "Verify a Google ID token server-side and login/register."
          }
        },
        {
          "name": "Get current user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "description": "Return the authenticated user (from the Bearer token)."
          }
        }
      ]
    },
