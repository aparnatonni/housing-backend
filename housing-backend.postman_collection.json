    {
      "name": "Payments",
      "item": [
        {
          "name": "Initiate payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"RENT\",\n  \"referenceId\": \"{{rentPaymentId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/payments/initiate",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "initiate"]
            },
            "description": "Start an SSLCommerz checkout (TENANT). `referenceId` is a RentPayment or BillSplit id depending on `type` (`RENT` | `BILL`). Returns a `gatewayPageURL` to redirect the browser to. Duplicate in-flight payment for the same reference returns 409."
          }
        },
        {
          "name": "Success callback",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/success?val_id={{valId}}&tran_id={{paymentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "success"],
              "query": [
                { "key": "val_id", "value": "{{valId}}", "description": "SSLCommerz validation id from the gateway redirect" },
                { "key": "tran_id", "value": "{{paymentId}}", "description": "The Payment id (tran_id)" }
              ]
            },
            "description": "Browser redirect callback. The server re-validates `val_id` with the gateway and only finalizes the payment if VALID. Requires a `valId` collection variable."
          }
        },
        {
          "name": "Fail callback",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/fail?tran_id={{paymentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "fail"],
              "query": [
                { "key": "tran_id", "value": "{{paymentId}}", "description": "The Payment id (tran_id)" }
              ]
            },
            "description": "Browser redirect callback for failed payments. Marks the payment FAILED and unlinks the reference."
          }
        },
        {
          "name": "Cancel callback",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/cancel?tran_id={{paymentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "cancel"],
              "query": [
                { "key": "tran_id", "value": "{{paymentId}}", "description": "The Payment id (tran_id)" }
              ]
            },
            "description": "Browser redirect callback when the user cancels. Marks the payment FAILED (cancelled)."
          }
        },
        {
          "name": "Webhook (IPN)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tran_id\": \"{{paymentId}}\",\n  \"val_id\": \"{{valId}}\",\n  \"status\": \"VALID\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/payments/webhook",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "webhook"]
            },
            "description": "SSLCommerz server-to-server IPN listener (also accepts form-encoded). Re-validates `val_id` before finalizing. Idempotent."
          }
        },
        {
          "name": "My payments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/my-payments?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "my-payments"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "Paginated payment history for the authenticated tenant (TENANT). Sets `{{paymentId}}` from the first item."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "execute": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.items && json.data.items.length > 0) {",
                  "  pm.collectionVariables.set('paymentId', json.data.items[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get payment by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/{{paymentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "{{paymentId}}"]
            },
            "description": "Payment status lookup (authed). The payer, the related property owner, or an admin can read it."
          }
        }
      ]
    },
