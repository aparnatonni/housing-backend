        {
          "name": "List properties",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/properties?page=1&limit=20&sortBy=newest&city=New%20York&minRent=500&maxRent=2000&propertyType=APARTMENT&search=",
              "host": ["{{baseUrl}}"],
              "path": ["properties"],
              "query": [
