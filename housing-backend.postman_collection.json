              "raw": "{{baseUrl}}/tenancies/{{tenancyId}}/rent-payments",
              "host": ["{{baseUrl}}"],
              "path": ["tenancies", "{{tenancyId}}", "rent-payments"]
            },
            "description": "Rent payment history and upcoming dues for a tenancy (tenant of the tenancy or its property owner)."
          }
        },
        {
          "name": "Generate rent payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dueDate\": \"2026-11-01T00:00:00.000Z\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/tenancies/{{tenancyId}}/rent-payments/generate",
              "host": ["{{baseUrl}}"],
              "path": ["tenancies", "{{tenancyId}}", "rent-payments", "generate"]
            },
            "description": "Generate the next rent payment for a tenancy (OWNER of the property). One payment per period; duplicate for the same month returns 409. Sets `{{rentPaymentId}}` from the response."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "execute": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.id) {",
                  "  pm.collectionVariables.set('rentPaymentId', json.data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Mark rent payment paid",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rent-payments/{{rentPaymentId}}/mark-paid",
              "host": ["{{baseUrl}}"],
              "path": ["rent-payments", "{{rentPaymentId}}", "mark-paid"]
            },
            "description": "Mark a rent payment as PAID (idempotent; used for cash/offline payments)."
          }
        }
      ]
    },
    {
