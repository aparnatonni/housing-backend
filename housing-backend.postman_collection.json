            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenancyId\": \"{{tenancyId}}\",\n  \"billType\": \"ELECTRICITY\",\n  \"totalAmount\": 300,\n  \"dueDate\": \"2026-10-20T00:00:00.000Z\",\n  \"ratio\": [1, 1]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/bill-splits",
              "host": ["{{baseUrl}}"],
              "path": ["bill-splits"]
            },
            "description": "Split a bill across the tenancy's roommates (OWNER or TENANT). Provide `ratio` (proportional) OR `shares` `[{ tenantId, amount }]`, not both. Sets `{{billSplitId}}` from the response."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "execute": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.id) {",
                  "  pm.collectionVariables.set('billSplitId', json.data.id);",
